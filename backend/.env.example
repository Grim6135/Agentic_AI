# TRIPPY Backend Environment Variables
# Copy to .env and fill in values as needed.

# Application & Environment
APP_NAME=TRIPPY
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# CORS (comma-separated origins or JSON array)
# In production on Render: CORS_ORIGINS=https://<your-vercel-app>.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Persistence & Storage
STORAGE_DIR=.data

# AI Provider (Server-side only; leave AI_ENABLED=false for deterministic mode)
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=15.0

# RAG Knowledge Base
RAG_ENABLED=true
RAG_PERSIST_DIR=.chroma

# External Integrations (Weather & Route APIs)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
MAPS_PROVIDER=osrm
MAPS_API_KEY=
INTEGRATION_TIMEOUT_SECONDS=5.0
INTEGRATION_CACHE_TTL_SECONDS=600



# ==============================================================================
# TRIPPY Backend — Environment Configuration & API Keys (Example Template)
# Copy this file to .env and input your API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=TRIPPY
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
STORAGE_DIR=.data
# Optional on local host. Required for PostgreSQL deployments:
DATABASE_URL=
RAG_ENABLED=true

# ------------------------------------------------------------------------------
# 2. AI / LLM PROVIDER API KEYS (REQUIRED FOR AGENTS)
# The multi-agent crew requires at least ONE LLM API key matching your chosen models.
# ------------------------------------------------------------------------------
# Groq API Key (Free & ultra-fast tier: https://console.groq.com/keys)
# Required if CREW_MODEL or ADK_MODEL starts with "groq/" (e.g., groq/openai/gpt-oss-120b)
GROQ_API_KEY=

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
# Required if using Gemini models (e.g., gemini/gemini-1.5-flash or gemini-1.5-pro)
GOOGLE_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
# Required if using OpenAI models (e.g., openai/gpt-4o or openai/gpt-4o-mini)
OPENAI_API_KEY=
AI_API_KEY=

# OpenRouter API Key (https://openrouter.ai/keys)
# Required if using OpenRouter gateway models (e.g., openrouter/meta-llama/...)
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 3. AGENT & MODEL CONFIGURATION
# ------------------------------------------------------------------------------
# Default models used by CrewAI specialists and Google ADK research agent:
CREW_MODEL=groq/openai/gpt-oss-120b
ADK_MODEL=groq/openai/gpt-oss-120b
ADK_BASE_URL=http://127.0.0.1:8001
ADK_SERVICE_TOKEN=

# ------------------------------------------------------------------------------
# 4. AGENT INTEGRATION & DATA ENHANCEMENT APIS (OPTIONAL / UPGRADABLE)
# ------------------------------------------------------------------------------
# Weather Integration (Stay & Activity Specialist):
# - Default: "open-meteo" (free, no API key required)
# - For commercial tier: supply WEATHER_API_KEY (Open-Meteo Customer Key or OpenWeatherMap)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# Maps & Routing Integration (Transport Specialist):
# - Default: "osrm" (free open-source road routing, no API key required)
# - For commercial routing: supply MAPS_API_KEY (Google Maps Directions / Mapbox)
MAPS_PROVIDER=osrm
MAPS_API_KEY=

# Real-World Places, POIs & Attractions (Destination & Stay/Activity Specialists):
# - Default uses Wikipedia Geosearch (free, no API key required).
# - Optional: Google Places API / TripAdvisor API key for commercial ratings & photos
PLACES_API_KEY=

# Live Currency & Forex Rates (Budget & Transport Specialists):
# - Default uses open.er-api.com (free, reliable baseline).
# - Optional: ExchangeRate-API / Fixer.io commercial key for high-volume SLA
FOREX_API_KEY=

# Live Flight & Transit Booking Inventory (Transport Specialist):
# - Default uses geodesic flight estimation + OSRM overland routes.
# - Optional: Amadeus Travel API credentials for live flight and rail inventory
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY & TRACING (LANGFUSE)
# Optional distributed tracing for agent events, token counts, and latency
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# ------------------------------------------------------------------------------
# 6. RATE LIMITING
# ------------------------------------------------------------------------------
HOURLY_CLIENT_LIMIT=4
HOURLY_GLOBAL_LIMIT=20
